---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  image: ImageMetadata;
  class?: string;
}

const { image, class: className } = Astro.props;
---

<!-- Fixed 2:1 tile so wordmarks and emblems sit at a consistent size. Decorative: the org name is right next to it. -->
<div class:list={['flex h-16 w-32 items-center justify-center border border-line bg-paper p-2', className]}>
  <Image src={image} alt="" height={48} densities={[1, 2, 3]} class="h-auto max-h-full w-auto max-w-full object-contain" />
</div>

---
import Figure from './Figure.astro';
import SectionHead from './SectionHead.astro';
import { writing } from '../data/profile';
---

<section id="writing" class="page">
  <div class="section">
    <SectionHead title="Writing" description="Notes and articles on the methods I teach." />

    <ul class="mt-12">
      {
        writing.map((w) => (
          <li class="grid gap-6 border-t border-line pt-8 md:grid-cols-12 md:gap-8">
            <Figure
              image={w.image}
              alt={w.title}
              caption={w.caption}
              ratio="16/9"
              sizes="(min-width: 768px) 520px, 100vw"
              class="md:col-span-5"
            />
            <div class="md:col-span-7">
              <p class="meta">
                {w.date} · {w.publisher} · {w.language}
              </p>
              <h3 class="mt-3 text-2xl leading-tight md:text-3xl">
                <a href={w.href} target="_blank" rel="noopener" class="hover:text-accent">
                  {w.title}
                </a>
              </h3>
              <p class="mt-4 max-w-2xl leading-relaxed text-muted">{w.body}</p>
              <a href={w.href} target="_blank" rel="noopener" class="link mt-6">
                {w.cta} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

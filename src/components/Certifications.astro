---
import Figure from './Figure.astro';
import SectionHead from './SectionHead.astro';
import { certifications } from '../data/profile';

const label = (name: string) => (/certificate/i.test(name) ? name : `${name} certificate`);
---

<section id="certifications" class="page">
  <div class="section">
    <SectionHead
      title="Certifications"
      description="Generative AI, machine learning, data science, and SQL, from Dicoding, DQLab, RevoU, HackerRank, and MySkill."
    />

    <ul class="mt-12 grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">
      {
        certifications.map((c) => (
          <li class="flex flex-col">
            <Figure image={c.image} alt={label(c.name)} ratio="16/9" />
            <p class="meta mt-5">
              Issued {c.issued}
              {c.expires && <> · Valid until {c.expires}</>}
            </p>
            <h3 class="mt-1 text-lg leading-snug">{c.name}</h3>
            <p class="mt-1 text-muted">{c.issuer}</p>
            {c.credentialId && <p class="meta mt-3 break-all">Credential ID {c.credentialId}</p>}
            {c.href && (
              <a href={c.href} target="_blank" rel="noopener" class="link mt-4 self-start">
                {c.href.includes('drive.google.com') ? 'View certificate' : 'Verify credential'} <span aria-hidden="true">↗</span>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

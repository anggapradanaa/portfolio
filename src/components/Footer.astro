---
import { profile, elsewhere } from '../data/profile';

const year = new Date().getFullYear();
---

<footer id="contact" class="page">
  <div class="grid gap-10 border-t border-rule py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5" data-reveal>
      <h2 class="text-4xl md:text-5xl">Find me online.</h2>
      <p class="mt-4 max-w-sm leading-relaxed text-muted">
        Email is the quickest way to reach me. I'm also on LinkedIn and GitHub.
      </p>
    </div>
    <ul class="grid content-start gap-x-8 sm:grid-cols-2 md:col-span-7">
      {
        elsewhere.map((l) => (
          <li data-reveal>
            <a
              href={l.href}
              target={l.external ? '_blank' : undefined}
              rel={l.external ? 'noopener' : undefined}
              class="flex items-center justify-between border-b border-line py-5 text-lg text-ink transition-colors hover:border-accent hover:text-accent"
            >
              {l.label}
              <span aria-hidden="true" class="arrow arrow-ext text-base">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <div class="flex flex-col gap-2 border-t border-line py-8 sm:flex-row sm:items-baseline sm:gap-6">
      <a href="#top" class="text-lg font-medium tracking-[-0.02em] text-ink">{profile.wordmark}</a>
      <span class="text-muted">{profile.role}</span>
      <span class="meta sm:ml-auto">© {year}</span>
    </div>
  </div>
</footer>

---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

interface Props {
  caption?: string;
  image?: ImageMetadata;
  alt?: string;
  /** CSS aspect-ratio of the frame, e.g. "16/9". Omit to use the image's own ratio. */
  ratio?: string;
  /** contain: show the whole image, leftover space stays pale. cover: fill the frame (crops). */
  fit?: 'contain' | 'cover';
  position?: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}

const {
  caption,
  image,
  alt = '',
  ratio,
  fit = 'contain',
  position = 'center',
  sizes = '(min-width: 1024px) 420px, 100vw',
  eager = false,
  class: className,
} = Astro.props;

// Larger version for the lightbox, capped at the source size
const full = image ? await getImage({ src: image, width: Math.min(image.width, 2000) }) : undefined;
---

<figure class={className}>
  {
    image ? (
      <div class="overflow-hidden border border-line bg-pale" style={{ aspectRatio: ratio }} data-reveal="image">
        <button
          type="button"
          class="zoom-trigger block h-full w-full"
          aria-label={alt ? `Enlarge image: ${alt}` : 'Enlarge image'}
          data-zoom={full?.src}
          data-zoom-w={image.width}
          data-zoom-h={image.height}
          data-zoom-alt={alt}
          data-zoom-caption={caption}
        >
          <Image
            src={image}
            alt={alt}
            widths={[480, 800, 1200]}
            sizes={sizes}
            loading={eager ? 'eager' : 'lazy'}
            class:list={['block w-full', ratio && 'h-full', fit === 'cover' ? 'object-cover' : 'object-contain']}
            style={{ objectPosition: position }}
          />
        </button>
      </div>
    ) : (
      <div
        class="graph-paper grid w-full place-items-center border border-dashed border-muted/50 bg-pale p-6 text-center"
        style={{ aspectRatio: ratio ?? '16/9' }}
        role="img"
        aria-label={`Placeholder: ${caption ?? alt}`}
      >
        <span class="bg-pale px-2 text-sm text-muted">
          <span class="block font-semibold tracking-[0.12em] uppercase">Placeholder</span>
          <span class="mt-1 block">{caption ?? alt}</span>
        </span>
      </div>
    )
  }
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .graph-paper {
    background-image:
      linear-gradient(var(--color-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-line) 1px, transparent 1px);
    background-size: 24px 24px;
  }
</style>
